---
import SlideViewer from '../../components/slides/SlideViewer';
import type { SlideDeck } from '../../components/slides/types';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDateMdDot } from '../../lib/date';
import { getSlideById, getSlides, type Slide } from '../../lib/microcms';
import { renderSlideHtml } from '../../lib/slideHtml';
import '../../styles/article.css';
import '../../styles/slideViewer.css';

export async function getStaticPaths() {
  const slides = await getSlides();
  return slides.map((slide) => ({
    params: { id: slide.id },
    props: { slide },
  }));
}

const { id } = Astro.params;
let { slide } = Astro.props as { slide: Slide };

if (!slide.content) {
  slide = await getSlideById(id as string);
}

const deck: SlideDeck = {
  id: slide.id,
  title: slide.title,
  date: formatDateMdDot(slide.createdAt),
  slides: renderSlideHtml(slide.content || ''),
};
---

<BaseLayout title={`${slide.title} | Slides | wato787`} description={`${slide.title}のスライドです。`}>
  <Fragment slot="head">
    <meta property="og:title" content={slide.title} />
    <meta property="og:description" content={`${slide.title}のスライドです。`} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={`/slides/${slide.id}`} />
  </Fragment>

  <SlideViewer client:only="react" deck={deck} closeHref="/slides" readHref={`/slides/${slide.id}/read`} />
</BaseLayout>
