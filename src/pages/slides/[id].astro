---
import SlideViewer from '../../components/SlideViewer';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSlideById, getSlides, type Slide } from '../../lib/microcms';
import { renderSlideHtml } from '../../lib/slideHtml';
import '../../styles/article.css';
import '../../styles/slideViewer.css';

export async function getStaticPaths() {
  const slides = await getSlides();
  return slides.map((slide) => ({
    params: { id: slide.id },
    props: { slide },
  }));
}

const { id } = Astro.params;
let { slide } = Astro.props as { slide: Slide };

if (!slide.content) {
  slide = await getSlideById(id as string);
}

const slideHtmlList = renderSlideHtml(slide.content || '');
const description = 'wato787のスライドです。';
---

<BaseLayout title={`${slide.title ?? 'Slides'} | wato787`} description={description}>
  <Fragment slot="head">
    <meta property="og:title" content={slide.title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={`/slides/${id}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={slide.title} />
    <meta name="twitter:description" content={description} />
  </Fragment>

  <main class="page">
    <SlideViewer client:load slides={slideHtmlList} title={slide.title} />
  </main>
</BaseLayout>

<style>
  .page {
    min-height: calc(100vh - 10rem);
    padding-block: 2rem 5rem;
  }
</style>
