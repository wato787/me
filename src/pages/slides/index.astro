---
import { ChevronRight } from 'lucide-astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDateMdDot } from '../../lib/date';
import { getSlides, type Slide } from '../../lib/microcms';

const slides = await getSlides();

const groupSlidesByYear = (items: Slide[]) => {
  const grouped: Record<string, Slide[]> = {};
  items.forEach((slide) => {
    const year = new Date(slide.createdAt).getFullYear().toString();
    grouped[year] ??= [];
    grouped[year].push(slide);
  });
  return grouped;
};

const groupedSlides = groupSlidesByYear(slides);
---

<BaseLayout title="SLIDES | wato787" description="これまでに作成したスライドの一覧です。">
  <div class="page">
    <div class="container">
      <header class="header">
        <h1 class="title">SLIDES</h1>
        <p class="subtitle">これまでに作成したスライドの一覧です。</p>
      </header>

      <div class="years">
        {
          Object.entries(groupedSlides)
            .sort(([yearA], [yearB]) => parseInt(yearB) - parseInt(yearA))
            .map(([year, yearSlides]) => (
              <section>
                <div class="yearHeader">
                  <span class="yearLabel mono-font">{year}</span>
                  <div class="yearLine"></div>
                </div>

                <div class="slides">
                  {yearSlides.map((slide) => (
                    <article class="slide">
                      <div class="slideRow">
                        <div class="dateCol">
                          <span class="date mono-font">{formatDateMdDot(slide.createdAt)}</span>
                        </div>

                        <div class="contentCol">
                          <a href={`/slides/${slide.id}`} class="titleLink">
                            <h2 class="slideTitle">{slide.title}</h2>
                          </a>

                          {slide.description && <p class="description">{slide.description}</p>}

                          <div class="readMoreWrap">
                            <a href={`/slides/${slide.id}`} class="readMore mono-font">
                              Open <ChevronRight size={12} />
                            </a>
                          </div>
                        </div>
                      </div>
                    </article>
                  ))}
                </div>
              </section>
            ))
        }
      </div>

      <div class="eof">
        <span class="eofLine"></span>
        <p class="eofText mono-font">EOF</p>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .page {
    min-height: 100vh;
    background: var(--color-background);
  }

  .container {
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: 1.5rem;
    padding-block: 5rem;
  }

  .header {
    margin-bottom: 8rem;
  }

  .title {
    font-size: 3.75rem;
    font-weight: 900;
    letter-spacing: -0.05em;
    color: var(--color-text-strong);
    line-height: 1;
    margin-bottom: 1.5rem;
  }

  @media (min-width: 768px) {
    .title {
      font-size: 6rem;
    }
  }

  .subtitle {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    font-weight: 500;
  }

  .years {
    display: flex;
    flex-direction: column;
    gap: 8rem;
  }

  .yearHeader {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 4rem;
  }

  .yearLabel {
    font-size: 0.75rem;
    font-weight: 900;
    color: var(--color-accent);
  }

  .yearLine {
    height: 1px;
    flex-grow: 1;
    background: var(--color-border);
  }

  .slides {
    display: flex;
    flex-direction: column;
    gap: 5rem;
  }

  .slide {
    position: relative;
  }

  .slideRow {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  @media (min-width: 768px) {
    .slideRow {
      flex-direction: row;
      gap: 4rem;
    }
  }

  .dateCol {
    flex-shrink: 0;
  }

  @media (min-width: 768px) {
    .dateCol {
      width: 8rem;
    }
  }

  .date {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-text-placeholder);
    transition: color 0.2s;
  }

  .slide:hover .date {
    color: var(--color-accent);
  }

  .contentCol {
    flex-grow: 1;
  }

  .titleLink {
    display: block;
    transition: transform 0.3s;
  }

  .slide:hover .titleLink {
    transform: translateX(0.25rem);
  }

  .slideTitle {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--color-text-strong);
    line-height: 1.25;
    transition: color 0.3s;
  }

  @media (min-width: 768px) {
    .slideTitle {
      font-size: 1.875rem;
    }
  }

  .slide:hover .slideTitle {
    color: var(--color-accent);
  }

  .description {
    margin-top: 1rem;
    color: var(--color-text-muted);
    line-height: 1.75;
    font-size: 0.9375rem;
  }

  .readMoreWrap {
    margin-top: 1.5rem;
  }

  .readMore {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--color-text-faint);
    font-size: 10px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    transition: color 0.2s;
  }

  .readMore:hover {
    color: var(--color-accent);
  }

  .eof {
    margin-top: 10rem;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .eofLine {
    height: 1px;
    flex-grow: 1;
    background: var(--color-border);
  }

  .eofText {
    color: var(--color-text-placeholder);
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 0.1em;
  }
</style>
