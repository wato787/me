---
import SlidesGallery, { type SlideCardDeck } from '../../components/SlidesGallery';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDateMdDot } from '../../lib/date';
import { getSlides } from '../../lib/microcms';
import '../../styles/slideViewer.css';

const slides = await getSlides();
const decks = slides.map((slide) => ({
  id: slide.id,
  title: slide.title,
  date: formatDateMdDot(slide.createdAt),
  year: new Date(slide.createdAt).getFullYear().toString(),
}));

const groupDecksByYear = (items: (SlideCardDeck & { year: string })[]) => {
  const grouped: Record<string, (SlideCardDeck & { year: string })[]> = {};
  items.forEach((deck) => {
    grouped[deck.year] ??= [];
    grouped[deck.year].push(deck);
  });
  return grouped;
};

const groupedDecks = groupDecksByYear(decks);
---

<BaseLayout title="SLIDES | wato787" description="これまでに作成したスライドの一覧です。">
  <div class="page">
    <header class="header">
      <h1 class="title">SLIDES</h1>
      <p class="subtitle">これまでに作成したスライドの一覧です。</p>
    </header>

    <div class="years">
      {
        Object.entries(groupedDecks)
          .sort(([yearA], [yearB]) => parseInt(yearB) - parseInt(yearA))
          .map(([year, yearDecks]) => (
            <section>
              <div class="yearHeader">
                <span class="yearLabel mono-font">{year}</span>
                <div class="yearLine"></div>
              </div>

              <SlidesGallery client:load decks={yearDecks.map(({ year: _year, ...deck }) => deck)} />
            </section>
          ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  .page {
    min-height: 100vh;
    background: var(--color-background);
    padding-block: 5rem 8rem;
  }

  .header {
    margin-bottom: 8rem;
  }

  .title {
    font-size: 3.75rem;
    font-weight: 900;
    letter-spacing: -0.05em;
    color: var(--color-text-strong);
    line-height: 1;
    margin-bottom: 1.5rem;
  }

  @media (min-width: 768px) {
    .title {
      font-size: 6rem;
    }
  }

  .subtitle {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    font-weight: 500;
  }

  .years {
    display: flex;
    flex-direction: column;
    gap: 8rem;
  }

  .yearHeader {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 4rem;
  }

  .yearLabel {
    font-size: 0.75rem;
    font-weight: 900;
    color: var(--color-accent);
  }

  .yearLine {
    height: 1px;
    flex-grow: 1;
    background: var(--color-border);
  }
</style>
