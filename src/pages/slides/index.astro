---
import SlidesGallery from '../../components/SlidesGallery';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDateMdDot } from '../../lib/date';
import { getSlides } from '../../lib/microcms';
import { renderSlideHtml } from '../../lib/slideHtml';
import '../../styles/slideViewer.css';

const slides = await getSlides();
const decks = slides.map((slide) => ({
  id: slide.id,
  title: slide.title,
  date: formatDateMdDot(slide.createdAt),
  slides: renderSlideHtml(slide.content || ''),
}));
---

<BaseLayout title="SLIDES | wato787" description="これまでに作成したスライドの一覧です。">
  <div class="page">
    <header class="header">
      <h1 class="title">SLIDES</h1>
      <p class="subtitle">これまでに作成したスライドの一覧です。</p>
    </header>

    <SlidesGallery client:load decks={decks} />
  </div>
</BaseLayout>

<style>
  .page {
    min-height: 100vh;
    background: var(--color-background);
    padding-block: 5rem 8rem;
  }

  .header {
    margin-bottom: 8rem;
  }

  .title {
    font-size: 3.75rem;
    font-weight: 900;
    letter-spacing: -0.05em;
    color: var(--color-text-strong);
    line-height: 1;
    margin-bottom: 1.5rem;
  }

  @media (min-width: 768px) {
    .title {
      font-size: 6rem;
    }
  }

  .subtitle {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    font-weight: 500;
  }
</style>
