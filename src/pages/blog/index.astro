---
import { ChevronRight } from 'lucide-astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDateMdDot } from '../../lib/date';
import { getBlogs, type Blog } from '../../lib/microcms';

const blogs = await getBlogs();

const groupBlogsByYear = (items: Blog[]) => {
  const grouped: Record<string, Blog[]> = {};
  items.forEach((blog) => {
    const year = new Date(blog.createdAt).getFullYear().toString();
    grouped[year] ??= [];
    grouped[year].push(blog);
  });
  return grouped;
};

const groupedBlogs = groupBlogsByYear(blogs);
---

<BaseLayout title="LOG | wato787" description="これまでに書いた記事の一覧です。">
  <div class="page">
    <div class="container">
      <header class="header">
        <h1 class="title">LOG</h1>
        <p class="subtitle">これまでに書いた記事の一覧です。</p>
      </header>

      <div class="years">
        {
          Object.entries(groupedBlogs)
            .sort(([yearA], [yearB]) => parseInt(yearB) - parseInt(yearA))
            .map(([year, yearBlogs]) => (
              <section>
                <div class="yearHeader">
                  <span class="yearLabel mono-font">{year}</span>
                  <div class="yearLine"></div>
                </div>

                <div class="articles">
                  {yearBlogs.map((blog) => (
                    <article class="article">
                      <div class="articleRow">
                        <div class="dateCol">
                          <span class="date mono-font">{formatDateMdDot(blog.createdAt)}</span>
                        </div>

                        <div class="contentCol">
                          <a href={`/blog/${blog.id}`} class="titleLink">
                            <h2 class="articleTitle">{blog.title}</h2>
                          </a>

                          {blog.description && <p class="description">{blog.description}</p>}

                          <div class="readMoreWrap">
                            <a href={`/blog/${blog.id}`} class="readMore mono-font">
                              Open <ChevronRight size={12} />
                            </a>
                          </div>
                        </div>
                      </div>
                    </article>
                  ))}
                </div>
              </section>
            ))
        }
      </div>

      <div class="eof">
        <span class="eofLine"></span>
        <p class="eofText mono-font">EOF</p>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .page {
    min-height: 100vh;
    background: var(--color-background);
  }

  .container {
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: 1.5rem;
    padding-block: 5rem;
  }

  .header {
    margin-bottom: 8rem;
  }

  .title {
    font-size: 3.75rem;
    font-weight: 900;
    letter-spacing: -0.05em;
    color: var(--color-text-strong);
    line-height: 1;
    margin-bottom: 1.5rem;
  }

  @media (min-width: 768px) {
    .title {
      font-size: 6rem;
    }
  }

  .subtitle {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    font-weight: 500;
  }

  .years {
    display: flex;
    flex-direction: column;
    gap: 8rem;
  }

  .yearHeader {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 4rem;
  }

  .yearLabel {
    font-size: 0.75rem;
    font-weight: 900;
    color: var(--color-accent);
  }

  .yearLine {
    height: 1px;
    flex-grow: 1;
    background: var(--color-border);
  }

  .articles {
    display: flex;
    flex-direction: column;
    gap: 5rem;
  }

  .article {
    position: relative;
  }

  .articleRow {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  @media (min-width: 768px) {
    .articleRow {
      flex-direction: row;
      gap: 4rem;
    }
  }

  .dateCol {
    flex-shrink: 0;
  }

  @media (min-width: 768px) {
    .dateCol {
      width: 8rem;
    }
  }

  .date {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-text-placeholder);
    transition: color 0.2s;
  }

  .article:hover .date {
    color: var(--color-accent);
  }

  .contentCol {
    flex-grow: 1;
  }

  .titleLink {
    display: block;
    transition: transform 0.3s;
  }

  .article:hover .titleLink {
    transform: translateX(0.25rem);
  }

  .articleTitle {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--color-text-strong);
    line-height: 1.25;
    transition: color 0.3s;
  }

  @media (min-width: 768px) {
    .articleTitle {
      font-size: 1.875rem;
    }
  }

  .article:hover .articleTitle {
    color: var(--color-accent);
  }

  .description {
    margin-top: 1rem;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    line-height: 1.625;
    max-width: 42rem;
  }

  .readMoreWrap {
    margin-top: 1.5rem;
  }

  .readMore {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 9px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-text-placeholder);
    transition: color 0.2s;
  }

  .article:hover .readMore {
    color: var(--color-accent);
  }

  .eof {
    margin-top: var(--section-gap);
    text-align: center;
  }

  .eofLine {
    display: inline-block;
    width: 2rem;
    height: 1px;
    background: var(--color-border);
    margin-bottom: 2rem;
  }

  .eofText {
    font-size: 9px;
    color: var(--color-text-placeholder);
    text-transform: uppercase;
    letter-spacing: 0.3em;
  }
</style>
