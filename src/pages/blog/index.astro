---
import { ChevronRight } from 'lucide-astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDateMdDot } from '../../lib/date';
import { getBlogs, type Blog } from '../../lib/microcms';

const blogs = await getBlogs();

const groupBlogsByYear = (items: Blog[]) => {
  const grouped: Record<string, Blog[]> = {};
  items.forEach((blog) => {
    const year = new Date(blog.createdAt).getFullYear().toString();
    grouped[year] ??= [];
    grouped[year].push(blog);
  });
  return grouped;
};

const groupedBlogs = groupBlogsByYear(blogs);
---

<BaseLayout title="LOG | wato787" description="これまでに書いた記事の一覧です。">
  <div class="page">
    <div class="container">
      <header class="header">
        <h1 class="title">LOG</h1>
        <p class="subtitle">これまでに書いた記事の一覧です。</p>
      </header>

      <div class="years">
        {
          Object.entries(groupedBlogs)
            .sort(([yearA], [yearB]) => parseInt(yearB) - parseInt(yearA))
            .map(([year, yearBlogs]) => (
              <section>
                <div class="yearHeader">
                  <span class="yearLabel mono-font">{year}</span>
                  <div class="yearLine"></div>
                </div>

                <div class="articles">
                  {yearBlogs.map((blog) => (
                    <article class="article">
                      <div class="articleRow">
                        <div class="dateCol">
                          <span class="date mono-font">{formatDateMdDot(blog.createdAt)}</span>
                        </div>

                        <div class="contentCol">
                          <a href={`/blog/${blog.id}`} class="titleLink">
                            <h2 class="articleTitle">{blog.title}</h2>
                          </a>

                          {blog.description && <p class="description">{blog.description}</p>}

                          <div class="readMoreWrap">
                            <a href={`/blog/${blog.id}`} class="readMore mono-font">
                              Open <ChevronRight size={12} />
                            </a>
                          </div>
                        </div>
                      </div>
                    </article>
                  ))}
                </div>
              </section>
            ))
        }
      </div>

      <div class="eof">
        <span class="eofLine"></span>
        <p class="eofText mono-font">EOF</p>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .page {
    min-height:70vh;
  }
  .container {
    padding-block:clamp(3rem,7vw,6rem);
  }
  .header {
    margin-bottom:4rem;
  }
  .title {
    font-family:'Manrope',sans-serif;
    font-size:clamp(3rem,7vw,5rem);
    letter-spacing:-.07em;
    line-height:1.1;
    font-weight:500;
    text-transform:lowercase;
    margin-bottom:1.5rem;
  }
  .subtitle {
    font-size:.95rem;
    color:var(--color-text-muted);
    line-height:1.9;
  }
  .years {
    display:flex;
    flex-direction:column;
    gap:4rem;
  }
  .yearHeader {
    display:flex;
    align-items:center;
    gap:1.5rem;
    margin-bottom:2rem;
  }
  .yearLabel {
    font-size:1rem;
    color:var(--color-accent);
  }
  .yearLine {
    height:1px;
    flex-grow:1;
    background:var(--color-border);
  }
  .articles {
    display:flex;
    flex-direction:column;
    gap:2.5rem;
  }
  .articleRow {
    display:flex;
    flex-direction:column;
    gap:.8rem;
  }
  .date {
    font-size:.85rem;
    color:var(--color-text-muted);
  }
  .contentCol {
    min-width:0;
    flex:1;
  }
  .articleTitle {
    font-size:clamp(1.2rem,2.4vw,1.65rem);
    font-weight:500;
    line-height:1.7;
    overflow-wrap:anywhere;
  }
  .titleLink:hover {
    color:var(--color-accent);
    text-decoration:underline;
  }
  .description {
    margin-top:.8rem;
    font-size:.9rem;
    line-height:1.9;
    color:var(--color-text-muted);
  }
  .readMoreWrap {
    margin-top:.8rem;
  }
  .readMore {
    display:inline-flex;
    align-items:center;
    gap:.3rem;
    min-height:44px;
    font-size:.8rem;
    color:var(--color-accent);
  }
  .readMore:hover {
    text-decoration:underline;
  }
  .eof {
    margin-top:5rem;
    text-align:center;
  }
  .eofLine {
    display:inline-block;
    width:2rem;
    height:1px;
    background:var(--color-border);
    margin-bottom:1rem;
  }
  .eofText {
    font-size:.75rem;
    color:var(--color-text-muted);
  }
  @media(min-width:768px) {
    .articleRow {
      flex-direction:row;
      gap:3rem;
    }
    .dateCol {
      flex:0 0 6rem;
      padding-top:.4rem;
    }
  }
</style>
