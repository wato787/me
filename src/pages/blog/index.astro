---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDateMdDot } from '../../lib/date';
import { getBlogs, type Blog } from '../../lib/microcms';

const blogs = await getBlogs();

const groupBlogsByYear = (items: Blog[]) => {
  const grouped: Record<string, Blog[]> = {};
  items.forEach((blog) => {
    const year = new Date(blog.createdAt).getFullYear().toString();
    grouped[year] ??= [];
    grouped[year].push(blog);
  });
  return grouped;
};

const groupedBlogs = groupBlogsByYear(blogs);
---

<BaseLayout title="記事 | wato787" description="これまでに書いた記事の一覧です。">
  <div class="page">
    <div class="container">
      <header class="header">
        <h1 class="title">記事</h1>
        <p class="subtitle">これまでに書いた記事の一覧です。</p>
      </header>

      <div class="years">
        {
          Object.entries(groupedBlogs)
            .sort(([yearA], [yearB]) => parseInt(yearB) - parseInt(yearA))
            .map(([year, yearBlogs]) => (
              <section>
                <div class="yearHeader">
                  <span class="yearLabel mono-font">{year}</span>
                </div>

                <div class="articles">
                  {yearBlogs.map((blog) => (
                    <article class="article">
                      <div class="articleRow">
                        <div class="dateCol">
                          <span class="date mono-font">{formatDateMdDot(blog.createdAt)}</span>
                        </div>

                        <div class="contentCol">
                          <a href={`/blog/${blog.id}`} class="titleLink">
                            <h2 class="articleTitle">{blog.title}</h2>
                          </a>

                          {blog.description && <p class="description">{blog.description}</p>}

                          <div class="readMoreWrap">
                            <a href={`/blog/${blog.id}`} class="readMore mono-font">
                              読む
                            </a>
                          </div>
                        </div>
                      </div>
                    </article>
                  ))}
                </div>
              </section>
            ))
        }
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .container {
    padding-block: 3rem 4rem;
  }
  .header {
    margin-bottom: 3rem;
  }
  .title {
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.5;
    margin-bottom: 0.5rem;
  }
  .subtitle {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
  }
  .years {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }
  .yearHeader {
    margin-bottom: 0.75rem;
  }
  .yearLabel {
    font-size: 1rem;
    font-weight: 600;
  }
  .articles {
    display: flex;
    flex-direction: column;
  }
  .article {
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--color-border);
  }
  .article:last-child {
    border-bottom: none;
  }
  .articleRow {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    gap: 1.5rem;
  }
  .date {
    color: var(--color-text-muted);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }
  .contentCol {
    min-width: 0;
  }
  .articleTitle {
    font-size: 1.0625rem;
    line-height: 1.7;
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  .titleLink:hover {
    text-decoration: underline;
  }
  .description {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    line-height: 1.85;
    color: var(--color-text-muted);
  }
  .readMore {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.8125rem;
    color: var(--color-accent);
    text-decoration: underline;
  }
  .readMore:hover {
    color: var(--color-accent-hover);
  }
  @media (max-width: 479px) {
    .container {
      padding-top: 2rem;
    }
    .articleRow {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
  }
</style>
