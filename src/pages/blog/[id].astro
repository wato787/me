---
import { ArrowLeft } from 'lucide-astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { renderArticleHtml } from '../../lib/articleHtml';
import { formatDateYmd } from '../../lib/date';
import { getBlogById, getBlogs, type Blog } from '../../lib/microcms';

export async function getStaticPaths() {
  const blogs = await getBlogs();
  return blogs.map((blog) => ({
    params: { id: blog.id },
    props: { blog },
  }));
}

const { id } = Astro.params;
let { blog } = Astro.props as { blog: Blog };

if (!blog.content) {
  blog = await getBlogById(id as string);
}

const post = {
  ...blog,
  date: formatDateYmd(blog.createdAt),
};
const description =
  post.description ?? (post.content ? `${post.content.replace(/<[^>]*>/g, '').slice(0, 160)}...` : undefined);
const articleHtml = renderArticleHtml(post.content || post.description || '');
---

<BaseLayout title={`${post.title ?? 'Blog'} | wato787`} description={description ?? 'wato787のブログ記事です。'}>
  <Fragment slot="head">
    <meta property="og:title" content={post.title} />
    <meta property="og:description" content={description ?? 'wato787のブログ記事です。'} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={`/blog/${id}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={post.title} />
    <meta name="twitter:description" content={description ?? 'wato787のブログ記事です。'} />
  </Fragment>

  <div class="page">
    <div class="container">
      <article class="article">
        <header class="header">
          <a href="/blog" class="backLink mono-font">
            <ArrowLeft size={14} class="backIcon" />
            Back
          </a>

          <div class="meta">
            <span class="date mono-font">{post.date}</span>
            <h1 class="title">{post.title}</h1>
          </div>
        </header>

        <div class="articleBody" set:html={articleHtml}></div>

        <div class="footer">
          <a href="/blog" class="footerLink mono-font">Back to list</a>
          <span class="footerNote mono-font">End of entry</span>
        </div>
      </article>
    </div>
  </div>

  <script>
    import Prism from 'prismjs';
    import 'prismjs/components/prism-markup';
    import 'prismjs/components/prism-css';
    import 'prismjs/components/prism-javascript';
    import 'prismjs/components/prism-typescript';
    import 'prismjs/components/prism-jsx';
    import 'prismjs/components/prism-tsx';
    import 'prismjs/components/prism-bash';
    import 'prismjs/components/prism-json';
    import 'prismjs/components/prism-yaml';

    Prism.highlightAll();
  </script>
</BaseLayout>

<style is:global>
  .articleBody {
    color: var(--color-text);
    font-size: 0.9375rem;
    line-height: 1.75;
    font-weight: 500;
    max-width: 28rem;
  }

  @media (min-width: 768px) {
    .articleBody {
      font-size: 1rem;
      line-height: 1.8;
      max-width: var(--container-max);
    }
  }

  .articleBody > * + * {
    margin-top: 1.5em;
  }

  .articleBody h1 {
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1.2;
    color: var(--color-text-strong);
    margin-top: 2em;
    margin-bottom: 0.5em;
  }

  .articleBody h1:first-child {
    margin-top: 0;
  }

  @media (min-width: 768px) {
    .articleBody h1 {
      font-size: 1.75rem;
    }
  }

  .articleBody h2 {
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.3;
    color: var(--color-text-strong);
    margin-top: 2em;
    margin-bottom: 0.5em;
    padding-bottom: 0.25em;
    border-bottom: 1px solid var(--color-border);
  }

  @media (min-width: 768px) {
    .articleBody h2 {
      font-size: 1.375rem;
    }
  }

  .articleBody h3 {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-text);
    margin-top: 1.75em;
    margin-bottom: 0.4em;
  }

  @media (min-width: 768px) {
    .articleBody h3 {
      font-size: 1.25rem;
    }
  }

  .articleBody h4,
  .articleBody h5,
  .articleBody h6 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text-subtle);
    margin-top: 1.5em;
    margin-bottom: 0.35em;
  }

  @media (min-width: 768px) {
    .articleBody h4,
    .articleBody h5,
    .articleBody h6 {
      font-size: 1.125rem;
    }
  }

  .articleBody p {
    margin-top: 0;
    margin-bottom: 1em;
  }

  .articleBody > * + p,
  .articleBody p + p {
    margin-top: 1em;
  }

  .articleBody ul,
  .articleBody ol {
    margin-top: 1em;
    margin-bottom: 1em;
    padding-left: 1.5em;
  }

  .articleBody ul {
    list-style-type: disc;
  }

  .articleBody ol {
    list-style-type: decimal;
  }

  .articleBody li {
    margin-top: 0.35em;
    margin-bottom: 0.35em;
  }

  .articleBody li::marker {
    color: var(--color-accent);
  }

  .articleBody ul ul,
  .articleBody ol ol,
  .articleBody ul ol,
  .articleBody ol ul {
    margin-top: 0.5em;
    margin-bottom: 0.5em;
  }

  .articleBody blockquote {
    margin-top: 1.5em;
    margin-bottom: 1.5em;
    padding-left: 1.25em;
    border-left: 4px solid var(--color-accent);
    color: var(--color-text-muted);
    font-style: italic;
  }

  .articleBody blockquote p:last-child {
    margin-bottom: 0;
  }

  .articleBody a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
    font-weight: 600;
  }

  .articleBody a:hover {
    color: var(--color-accent-hover);
  }

  .articleBody code {
    font-family: 'JetBrains Mono', monospace;
    font-variant-ligatures: none;
    font-feature-settings: 'liga' 0, 'calt' 0;
    font-size: 0.9em;
    padding: 0.15em 0.4em;
    background: var(--color-surface);
    border-radius: 0.25rem;
    border: 1px solid var(--color-border);
  }

  .articleBody pre {
    margin-top: 1.5em;
    margin-bottom: 1.5em;
  }

  .articleBody pre code {
    padding: 0;
    background: transparent;
    border: none;
    font-size: inherit;
  }

  .articleBody strong {
    font-weight: 700;
    color: var(--color-text-strong);
  }

  .articleBody em {
    font-style: italic;
  }

  .articleBody hr {
    margin-top: 2em;
    margin-bottom: 2em;
    border: none;
    border-top: 1px solid var(--color-border);
  }

  .articleBody table {
    width: 100%;
    margin-top: 1.5em;
    margin-bottom: 1.5em;
    border-collapse: collapse;
    font-size: 0.95em;
  }

  .articleBody th,
  .articleBody td {
    padding: 0.5em 0.75em;
    border: 1px solid var(--color-border);
    text-align: left;
  }

  .articleBody th {
    background: var(--color-surface);
    font-weight: 600;
    color: var(--color-text-strong);
  }

  .articleBody .mediaWrap {
    display: block;
    margin-block: 2.5rem;
  }

  .articleBody .mediaWrapAspect {
    display: block;
    margin-block: 2.5rem;
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
  }

  .articleBody .mediaImage {
    height: auto;
    width: 100%;
    border-radius: 0.5rem;
    border: 1px solid var(--color-border);
  }

  .articleBody .mediaImageFill {
    width: 100%;
    height: 100%;
    border-radius: 0.5rem;
    border: 1px solid var(--color-border);
    object-fit: contain;
  }

  .articleBody .embed {
    position: relative;
    margin-block: 2.5rem;
    width: 100%;
    aspect-ratio: 16 / 9;
  }

  .articleBody .embedFrame {
    position: absolute;
    inset: 0;
    height: 100%;
    width: 100%;
    border-radius: 0.5rem;
    border: 1px solid var(--color-border);
  }

  .articleBody .codeBlock {
    margin-block: 2.5rem;
    overflow-x: auto;
    border-radius: 0.5rem;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    padding: 1rem;
    font-size: 0.875rem;
    font-family: 'JetBrains Mono', monospace;
    font-variant-ligatures: none;
    font-feature-settings: 'liga' 0, 'calt' 0;
  }
</style>

<style>
  .page {
    min-height: 100vh;
    background: var(--color-background);
  }

  .container {
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: 0;
  }

  @media (min-width: 768px) {
    .container {
      padding-inline: 1.5rem;
    }
  }

  .article {
    padding-block: 3rem;
  }

  .header {
    margin-bottom: 3.5rem;
  }

  .backLink {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 10px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-faint);
    margin-bottom: 3rem;
    transition: color 0.2s;
  }

  .backLink:hover {
    color: var(--color-accent);
  }

  .backLink:hover .backIcon {
    transform: translateX(-0.25rem);
  }

  .backIcon {
    transition: transform 0.2s;
  }

  .meta {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .date {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-accent);
  }

  .title {
    font-size: 1.625rem;
    font-weight: 900;
    letter-spacing: -0.025em;
    color: var(--color-text-strong);
    line-height: 1.35;
  }

  @media (min-width: 768px) {
    .article {
      padding-block: 4rem;
    }

    .header {
      margin-bottom: 4rem;
    }

    .title {
      font-size: 2.5rem;
      line-height: 1.25;
    }
  }

  .footer {
    margin-top: 10rem;
    padding-top: 5rem;
    border-top: 1px solid var(--color-border);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .footerLink {
    font-size: 10px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-faint);
    transition: color 0.2s;
  }

  .footerLink:hover {
    color: var(--color-accent);
  }

  .footerNote {
    font-size: 10px;
    color: var(--color-text-placeholder);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
</style>
