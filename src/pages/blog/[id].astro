---
import { ArrowLeft } from 'lucide-astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { renderArticleHtml } from '../../lib/articleHtml';
import { formatDateYmd } from '../../lib/date';
import { getBlogById, getBlogs, type Blog } from '../../lib/microcms';
import '../../styles/article.css';

export async function getStaticPaths() {
  const blogs = await getBlogs();
  return blogs.map((blog) => ({
    params: { id: blog.id },
    props: { blog },
  }));
}

const { id } = Astro.params;
let { blog } = Astro.props as { blog: Blog };

if (!blog.content) {
  blog = await getBlogById(id as string);
}

const post = {
  ...blog,
  date: formatDateYmd(blog.createdAt),
};
const description =
  post.description ?? (post.content ? `${post.content.replace(/<[^>]*>/g, '').slice(0, 160)}...` : undefined);
const articleHtml = renderArticleHtml(post.content || post.description || '');
---

<BaseLayout title={`${post.title ?? 'Blog'} | wato787`} description={description ?? 'wato787のブログ記事です。'}>
  <Fragment slot="head">
    <meta property="og:title" content={post.title} />
    <meta property="og:description" content={description ?? 'wato787のブログ記事です。'} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={`/blog/${id}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={post.title} />
    <meta name="twitter:description" content={description ?? 'wato787のブログ記事です。'} />
  </Fragment>

  <div class="page">
    <div class="container">
      <article class="article">
        <header class="header">
          <a href="/blog" class="backLink mono-font">
            <ArrowLeft size={14} class="backIcon" />
            Back
          </a>

          <div class="meta">
            <span class="date mono-font">{post.date}</span>
            <h1 class="title">{post.title}</h1>
          </div>
        </header>

        <div class="articleBody" set:html={articleHtml}></div>

        <div class="footer">
          <a href="/blog" class="footerLink mono-font">Back to list</a>
          <span class="footerNote mono-font">End of entry</span>
        </div>
      </article>
    </div>
  </div>
</BaseLayout>

<style>
  .page {
    min-height: 100vh;
    background: var(--color-background);
  }

  .container {
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: 0;
  }

  @media (min-width: 768px) {
    .container {
      padding-inline: 1.5rem;
    }
  }

  .article {
    padding-block: 3rem;
  }

  .header {
    margin-bottom: 3.5rem;
  }

  .backLink {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 10px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-faint);
    margin-bottom: 3rem;
    transition: color 0.2s;
  }

  .backLink:hover {
    color: var(--color-accent);
  }

  .backLink:hover .backIcon {
    transform: translateX(-0.25rem);
  }

  .backIcon {
    transition: transform 0.2s;
  }

  .meta {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .date {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-accent);
  }

  .title {
    font-size: 1.625rem;
    font-weight: 900;
    letter-spacing: -0.025em;
    color: var(--color-text-strong);
    line-height: 1.35;
  }

  @media (min-width: 768px) {
    .article {
      padding-block: 4rem;
    }

    .header {
      margin-bottom: 4rem;
    }

    .title {
      font-size: 2.5rem;
      line-height: 1.25;
    }
  }

  .footer {
    margin-top: 10rem;
    padding-top: 5rem;
    border-top: 1px solid var(--color-border);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .footerLink {
    font-size: 10px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-faint);
    transition: color 0.2s;
  }

  .footerLink:hover {
    color: var(--color-accent);
  }

  .footerNote {
    font-size: 10px;
    color: var(--color-text-placeholder);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
</style>
