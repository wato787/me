---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { renderArticleHtml } from '../../lib/articleHtml';
import { formatDateYmd } from '../../lib/date';
import { getBlogById, getBlogs, type Blog } from '../../lib/microcms';
import '../../styles/article.css';

export async function getStaticPaths() {
  const blogs = await getBlogs();
  return blogs.map((blog) => ({
    params: { id: blog.id },
    props: { blog },
  }));
}

const { id } = Astro.params;
let { blog } = Astro.props as { blog: Blog };

if (!blog.content) {
  blog = await getBlogById(id as string);
}

const post = {
  ...blog,
  date: formatDateYmd(blog.createdAt),
};
const description =
  post.description ?? (post.content ? `${post.content.replace(/<[^>]*>/g, '').slice(0, 160)}...` : undefined);
const articleHtml = renderArticleHtml(post.content || post.description || '');
---

<BaseLayout title={`${post.title ?? 'Blog'} | wato787`} description={description ?? 'wato787のブログ記事です。'}>
  <Fragment slot="head">
    <meta property="og:title" content={post.title} />
    <meta property="og:description" content={description ?? 'wato787のブログ記事です。'} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={`/blog/${id}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={post.title} />
    <meta name="twitter:description" content={description ?? 'wato787のブログ記事です。'} />
  </Fragment>

  <div class="page">
    <div class="container">
      <article class="article">
        <header class="header">
          <a href="/blog" class="backLink mono-font">
            記事一覧に戻る
          </a>

          <div class="meta">
            <span class="date mono-font">{post.date}</span>
            <h1 class="title">{post.title}</h1>
          </div>
        </header>

        <div class="articleBody" set:html={articleHtml}></div>

        <div class="footer">
          <a href="/blog" class="footerLink mono-font">記事一覧に戻る</a>
        </div>
      </article>
    </div>
  </div>
</BaseLayout>

<style>
  .article {
    padding-block: 2rem 4rem;
  }
  .header {
    margin-bottom: 2.5rem;
  }
  .backLink {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-bottom: 1.5rem;
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }
  .backLink:hover {
    text-decoration: underline;
  }
  .meta {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .date {
    color: var(--color-text-muted);
    font-size: 0.8125rem;
  }
  .title {
    font-size: clamp(1.5rem, 3.6vw, 2rem);
    line-height: 1.65;
    font-weight: 700;
    overflow-wrap: anywhere;
  }
  .footer {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }
  .footerLink {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.875rem;
    color: var(--color-accent);
    text-decoration: underline;
  }
  .footerLink:hover {
    color: var(--color-accent-hover);
  }
</style>
