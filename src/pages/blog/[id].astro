---
import { ArrowLeft } from 'lucide-astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { renderArticleHtml } from '../../lib/articleHtml';
import { formatDateYmd } from '../../lib/date';
import { getBlogById, getBlogs, type Blog } from '../../lib/microcms';
import '../../styles/article.css';

export async function getStaticPaths() {
  const blogs = await getBlogs();
  return blogs.map((blog) => ({
    params: { id: blog.id },
    props: { blog },
  }));
}

const { id } = Astro.params;
let { blog } = Astro.props as { blog: Blog };

if (!blog.content) {
  blog = await getBlogById(id as string);
}

const post = {
  ...blog,
  date: formatDateYmd(blog.createdAt),
};
const description =
  post.description ?? (post.content ? `${post.content.replace(/<[^>]*>/g, '').slice(0, 160)}...` : undefined);
const articleHtml = renderArticleHtml(post.content || post.description || '');
---

<BaseLayout title={`${post.title ?? 'Blog'} | wato787`} description={description ?? 'wato787のブログ記事です。'}>
  <Fragment slot="head">
    <meta property="og:title" content={post.title} />
    <meta property="og:description" content={description ?? 'wato787のブログ記事です。'} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={`/blog/${id}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={post.title} />
    <meta name="twitter:description" content={description ?? 'wato787のブログ記事です。'} />
  </Fragment>

  <div class="page">
    <div class="container">
      <article class="article">
        <header class="header">
          <a href="/blog" class="backLink mono-font">
            <ArrowLeft size={14} class="backIcon" />
            Back
          </a>

          <div class="meta">
            <span class="date mono-font">{post.date}</span>
            <h1 class="title">{post.title}</h1>
          </div>
        </header>

        <div class="articleBody" set:html={articleHtml}></div>

        <div class="footer">
          <a href="/blog" class="footerLink mono-font">Back to list</a>
          <span class="footerNote mono-font">End of entry</span>
        </div>
      </article>
    </div>
  </div>
</BaseLayout>

<style>
  .page {
    min-height:70vh;
  }
  .container {
    max-width:44rem;
    margin-inline:auto;
  }
  .article {
    padding-block:3rem;
  }
  .header {
    margin-bottom:3rem;
  }
  .backLink {
    display:inline-flex;
    align-items:center;
    gap:.5rem;
    min-height:44px;
    font-size:.85rem;
    color:var(--color-text-muted);
    margin-bottom:2rem;
  }
  .backLink:hover {
    text-decoration:underline;
    color:var(--color-accent);
  }
  .meta {
    display:flex;
    flex-direction:column;
    gap:1rem;
  }
  .date {
    font-size:.85rem;
    color:var(--color-text-muted);
  }
  .title {
    font-size:clamp(1.6rem,3.5vw,2.4rem);
    font-weight:500;
    letter-spacing:-.035em;
    line-height:1.6;
    overflow-wrap:anywhere;
  }
  .footer {
    margin-top:5rem;
    padding-top:2rem;
    border-top:1px solid var(--color-border);
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:1rem;
  }
  .footerLink {
    display:inline-flex;
    align-items:center;
    min-height:44px;
    font-size:.85rem;
    color:var(--color-accent);
  }
  .footerLink:hover {
    text-decoration:underline;
  }
  .footerNote {
    font-size:.75rem;
    color:var(--color-text-muted);
  }
</style>
