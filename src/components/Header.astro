---
import { getProfile } from '../lib/microcms';
const profile = await getProfile();
---

<header class="header">
  <a href="/" class="brand">{profile.name}</a>
  <nav aria-label="メインナビゲーション">
    <a href="/blog" class="navLink" aria-current={Astro.url.pathname.startsWith('/blog') ? 'page' : undefined}>記事</a>
  </nav>
</header>

<style>
  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-block: 1rem;
    gap: 1rem;
  }
  .brand, .navLink {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.875rem;
  }
  .brand {
    font-weight: 600;
  }
  .navLink {
    color: var(--color-text-muted);
  }
  .navLink:hover, .navLink[aria-current] {
    color: var(--color-text-strong);
    text-decoration: underline;
  }
</style>
