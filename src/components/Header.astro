---
import { Terminal } from 'lucide-astro';
import { getProfile } from '../lib/microcms';

const profile = await getProfile();
---

<header class="header">
  <a href="/" class="logoLink">
    <Terminal size={18} class="logoIcon" />
    <span class="logoText mono-font">{profile.name}</span>
  </a>
  <nav>
    <ul class="navList">
      <li>
        <a href="/blog" class="navLink">Blog</a>
      </li>
    </ul>
  </nav>
</header>

<style>
  .header {
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding-block:1.6rem;
    border-bottom:1px solid var(--color-border);
  }
  .logoLink {
    display:flex;
    align-items:center;
    gap:.7rem;
    min-height:44px;
  }
  .logoIcon {
    color:var(--color-accent);
  }
  .logoText {
    font-size:1rem;
    font-weight:700;
    letter-spacing:-.04em;
  }
  .navList {
    list-style:none;
    margin:0;
    padding:0;
  }
  .navLink {
    display:inline-flex;
    align-items:center;
    min-height:44px;
    padding-inline:.5rem;
    font-size:.9rem;
  }
  .navLink:hover {
    text-decoration:underline;
  }
</style>
