---
import { getProfile } from '../lib/microcms';

const profile = await getProfile();
const year = new Date().getFullYear();
---

<footer class="footer">
  <a href="/" class="brand mono-font">{profile.name}</a>

  <div class="links">
    <a href={profile.xUrl} target="_blank" rel="noopener noreferrer" class="link">X</a>
    <a href={profile.githubUrl} target="_blank" rel="noopener noreferrer" class="link">GitHub</a>
    <span class="divider"></span>
    <span class="copyright mono-font">&copy; {year}</span>
  </div>
</footer>

<style>
  .footer {
    padding-block:2rem;
    border-top:1px solid var(--color-border);
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:1.5rem;
    flex-wrap:wrap;
  }
  .brand {
    font-size:.9rem;
    font-weight:600;
    letter-spacing:-.04em;
    min-height:44px;
    display:inline-flex;
    align-items:center;
  }
  .links {
    display:flex;
    gap:1.5rem;
    align-items:center;
    font-size:.8rem;
    color:var(--color-text-muted);
  }
  .link {
    min-height:44px;
    display:inline-flex;
    align-items:center;
  }
  .link:hover {
    text-decoration:underline;
    color:var(--color-accent);
  }
  .divider {
    width:1px;
    height:12px;
    background:var(--color-border);
  }
  .copyright {
    font-size:.75rem;
  }
</style>
