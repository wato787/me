---
import { getProfile } from '../lib/microcms';
const profile = await getProfile();
const year = new Date().getFullYear();
---

<footer class="footer">
  <a href="/" class="brand">{profile.name}</a>
  <div class="links">
    <a href={profile.xUrl} target="_blank" rel="noopener noreferrer">X</a>
    <a href={profile.githubUrl} target="_blank" rel="noopener noreferrer">GitHub</a>
    <span>&copy; {year}</span>
  </div>
</footer>

<style>
  .footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem 1.5rem;
    border-top: 1px solid var(--color-border);
    padding-block: 1rem 2rem;
    color: var(--color-text-muted);
    font-size: 0.8125rem;
  }
  .links {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }
  a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  a:hover {
    text-decoration: underline;
    color: var(--color-text-strong);
  }
</style>
