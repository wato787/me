---
import { ArrowUpRight } from 'lucide-astro';
import { getProfile } from '../lib/microcms';

const profile = await getProfile();
---

<section class="section">
  <div class="inner">
    <div>
      <h2 class="heading">CONTACT</h2>
      <p class="message">
        お仕事のご相談は
        <a href={profile.xUrl} target="_blank" rel="noopener noreferrer" class="inlineLink">X</a>
        のDMまで。
      </p>
    </div>

    <a href={profile.xUrl} target="_blank" rel="noopener noreferrer" class="button">
      <span>DMを送る</span>
      <ArrowUpRight size={18} />
    </a>
  </div>
</section>

<style>
  .section {
    margin-bottom:var(--section-gap-sm);
    padding-top:3rem;
    border-top:1px solid var(--color-border);
  }
  .inner {
    display:flex;
    flex-direction:column;
    gap:2rem;
    justify-content:space-between;
  }
  .heading {
    font-family:'Manrope',sans-serif;
    font-size:1.5rem;
    font-weight:500;
    letter-spacing:-.04em;
    text-transform:lowercase;
    margin-bottom:1.5rem;
  }
  .message {
    font-size:clamp(1.1rem,2.5vw,1.6rem);
    line-height:1.9;
    font-weight:500;
    letter-spacing:-.03em;
  }
  .inlineLink {
    color:var(--color-accent);
    text-decoration:underline;
  }
  .button {
    display:inline-flex;
    align-items:center;
    justify-content:space-between;
    gap:2rem;
    align-self:flex-start;
    padding:.9rem 1.3rem;
    border:1px solid var(--color-accent);
    color:var(--color-accent);
    border-radius:3px;
    font-size:.9rem;
  }
  .button:hover {
    background:var(--color-accent);
    color:#fff;
  }
  @media(min-width:768px) {
    .inner {
      flex-direction:row;
      align-items:center;
    }
    .button {
      align-self:center;
    }
  }
</style>
