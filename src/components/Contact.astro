---
import { ArrowUpRight } from 'lucide-astro';
import { getProfile } from '../lib/microcms';

const profile = await getProfile();
---

<section class="section">
  <div class="inner">
    <div>
      <h2 class="heading">CONTACT</h2>
      <p class="message">
        お仕事のご相談は
        <a href={profile.xUrl} target="_blank" rel="noopener noreferrer" class="inlineLink">X</a>
        のDMまで。
      </p>
    </div>

    <a href={profile.xUrl} target="_blank" rel="noopener noreferrer" class="button">
      <span>DMを送る</span>
      <ArrowUpRight size={18} />
    </a>
  </div>
</section>

<style>
  .section {
    margin-bottom: var(--section-gap-sm);
    padding-top: 5rem;
    border-top: 1px solid var(--color-border);
  }

  .inner {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .inner {
      flex-direction: row;
      align-items: center;
    }
  }

  .heading {
    font-size: 11px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.5em;
    color: var(--color-accent);
    margin-bottom: 1rem;
  }

  .message {
    font-size: 1.875rem;
    font-weight: 900;
    letter-spacing: -0.05em;
    color: var(--color-text-strong);
  }

  .inlineLink {
    color: var(--color-accent);
  }

  .inlineLink:hover {
    text-decoration: underline;
  }

  .button {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    background: var(--color-text-strong);
    color: white;
    padding: 1rem 2rem;
    border-radius: 0.75rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    transition: background 0.3s;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  }

  .button:hover {
    background: var(--color-accent);
  }
</style>
