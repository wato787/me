---
import { getProfile } from '../lib/microcms';
const profile = await getProfile();
---

<section class="section" aria-labelledby="contact-heading">
  <h2 id="contact-heading" class="sectionHeading">連絡先</h2>
  <p class="message">
    お仕事のご相談は<a href={profile.xUrl} target="_blank" rel="noopener noreferrer" class="textLink">X</a>のDMまで。
  </p>
  <a href={profile.xUrl} target="_blank" rel="noopener noreferrer" class="textLink contactLink">DMを送る</a>
</section>

<style>
  .section {
    margin-bottom: 4rem;
  }
  .message {
    color: var(--color-text);
  }
  .contactLink {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 0.5rem;
    font-size: 0.875rem;
  }
</style>
