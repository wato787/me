---
import { getSkills } from '../lib/microcms';
const skills = await getSkills();
---

<section class="section" aria-labelledby="skills-heading">
  <h2 id="skills-heading" class="sectionHeading">使っている技術</h2>
  <ul class="skills">
    {skills.map((skill) => <li>{skill.name}</li>)}
  </ul>
</section>

<style>
  .section {
    margin-bottom: var(--section-gap);
  }
  .skills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .skills li {
    padding: 0.15rem 0.625rem;
    border-radius: 4px;
    background: var(--color-surface);
    color: var(--color-text-subtle);
    font-size: 0.875rem;
    overflow-wrap: anywhere;
    max-width: 100%;
  }
</style>
