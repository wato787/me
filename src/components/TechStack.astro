---
import { getSkills } from '../lib/microcms';

const skills = await getSkills();
---

<section class="section">
  <h2 class="heading">SKILLS</h2>
  <div class="grid">
    {
      skills.map((skill) => (
        <div class="item">
          <div class="dot" style={{ backgroundColor: skill.color || '#d4d4d8' }}></div>
          <span class="name mono-font">{skill.name}</span>
        </div>
      ))
    }
  </div>
</section>

<style>
  .section {
    margin-bottom:var(--section-gap);
  }
  .heading {
    font-family:'Manrope',sans-serif;
    font-size:1.5rem;
    font-weight:500;
    letter-spacing:-.04em;
    text-transform:lowercase;
    margin-bottom:2rem;
  }
  .grid {
    display:grid;
    grid-template-columns:repeat(2,minmax(0,1fr));
    gap:1.5rem 1rem;
  }
  .item {
    display:flex;
    align-items:center;
    gap:.7rem;
    min-width:0;
  }
  .dot {
    width:6px;
    height:6px;
    border-radius:50%;
    flex-shrink:0;
  }
  .name {
    font-size:.95rem;
    font-weight:400;
    overflow-wrap:anywhere;
  }
  @media(min-width:768px) {
    .grid {
      grid-template-columns:repeat(3,minmax(0,1fr));
      gap:2rem;
    }
  }
</style>
