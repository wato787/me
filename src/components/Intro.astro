---
import { ArrowRight, Code, MapPin } from 'lucide-astro';
import { getProfile, optimizeImageUrl } from '../lib/microcms';

const profile = await getProfile();
const imageUrl = profile.image?.url ? optimizeImageUrl(profile.image.url, 800, 800, 'webp') : null;
---

<section class="section">
  {
    imageUrl && (
      <div class="imageGroup">
        <div class="imageFrame">
          <img
            src={imageUrl}
            alt={profile.name}
            width="800"
            height="800"
            class="profileImage"
            loading="eager"
            decoding="async"
          />
          <div class="imageOverlay"></div>
        </div>
      </div>
    )
  }

  <div class="content">
    <div class="labelRow">
      <div class="labelDot"></div>
      <span class="label">PROFILE</span>
    </div>

    <h2 class="name">{profile.name}</h2>

    <div class="descriptionWrap">
      <p class="description">{profile.description}</p>
    </div>

    <div class="locationWrap">
      <div class="locationRow">
        <div class="locationIconWrap">
          <MapPin size={14} class="locationIcon" />
        </div>
        <span class="locationText">{profile.area}</span>
      </div>
    </div>

    <div class="socialGrid">
      <a href={profile.xUrl} target="_blank" rel="noopener noreferrer" class="card">
        <div class="cardInner">
          <div class="cardIcon">
            <span class="cardX">X</span>
          </div>
          <span class="cardLabel mono-font">X</span>
        </div>
        <ArrowRight size={14} class="cardArrow" />
      </a>

      <a href={profile.githubUrl} target="_blank" rel="noopener noreferrer" class="card">
        <div class="cardInner">
          <div class="cardIcon">
            <Code size={18} />
          </div>
          <span class="cardLabel mono-font">GitHub</span>
        </div>
        <ArrowRight size={14} class="cardArrow" />
      </a>
    </div>
  </div>
</section>

<style>
  .section {
    padding-block:clamp(3rem,7vw,6rem) var(--section-gap);
    display:grid;
    grid-template-columns:1fr;
    gap:2.5rem;
    align-items:center;
  }
  .imageFrame {
    aspect-ratio:1;
    overflow:hidden;
    border-radius:4px;
    background:var(--color-surface);
  }
  .profileImage {
    display:block;
    width:100%;
    height:100%;
    object-fit:cover;
  }
  .imageOverlay {
    display:none;
  }
  .labelRow {
    margin-bottom:1rem;
  }
  .labelDot {
    display:none;
  }
  .label {
    font-size:.8rem;
    font-weight:500;
    color:var(--color-text-muted);
    text-transform:lowercase;
  }
  .name {
    font-family:'Manrope','Noto Sans JP',sans-serif;
    font-size:clamp(3rem,7.5vw,5.75rem);
    font-weight:500;
    letter-spacing:-.075em;
    line-height:1.1;
    margin-bottom:1.5rem;
  }
  .description {
    color:var(--color-text);
    font-size:.95rem;
    line-height:2;
    max-width:30rem;
  }
  .locationWrap {
    margin-block:1.5rem 2rem;
  }
  .locationRow {
    display:flex;
    align-items:center;
    gap:.5rem;
  }
  .locationIconWrap {
    display:flex;
  }
  .locationIcon {
    color:var(--color-text-muted);
  }
  .locationText {
    font-size:.85rem;
    color:var(--color-text-muted);
  }
  .socialGrid {
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:1.5rem;
  }
  .card {
    display:flex;
    justify-content:space-between;
    align-items:center;
    min-height:48px;
    border-bottom:1px solid var(--color-border);
    padding-block:.7rem;
  }
  .cardInner {
    display:flex;
    align-items:center;
    gap:.7rem;
  }
  .cardIcon {
    display:flex;
    align-items:center;
  }
  .cardX {
    font-size:1rem;
  }
  .cardLabel {
    font-size:.85rem;
    font-weight:500;
  }
  .cardArrow {
    color:var(--color-accent);
  }
  .card:hover {
    border-color:var(--color-accent);
    color:var(--color-accent);
  }
  @media(min-width:768px) {
    .section {
      grid-template-columns:minmax(0,1fr) minmax(0,1.2fr);
      gap:clamp(3rem,7vw,6rem);
    }
  }
</style>
