---
import { getProfile, optimizeImageUrl } from '../lib/microcms';
const profile = await getProfile();
const imageUrl = profile.image?.url ? optimizeImageUrl(profile.image.url, 192, 192, 'webp') : null;
---

<section class="profile" aria-labelledby="profile-name">
  <div class="identity">
    {imageUrl && <img src={imageUrl} alt={profile.name} width="80" height="80" class="photo" loading="eager" decoding="async" />}
    <div>
      <h1 id="profile-name" class="name">{profile.name}</h1>
      <p class="location">{profile.area}</p>
    </div>
  </div>
  {profile.description && <p class="description">{profile.description}</p>}
  <div class="socials">
    <a href={profile.xUrl} target="_blank" rel="noopener noreferrer" class="textLink">X</a>
    <a href={profile.githubUrl} target="_blank" rel="noopener noreferrer" class="textLink">GitHub</a>
  </div>
</section>

<style>
  .profile {
    padding-block: 3.5rem 4rem;
  }
  .identity {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 1.5rem;
  }
  .photo {
    display: block;
    width: 80px;
    height: 80px;
    flex-shrink: 0;
    object-fit: cover;
    border-radius: 18px;
    background: var(--color-surface);
  }
  .name {
    font-size: 1.875rem;
    line-height: 1.35;
    font-weight: 700;
    letter-spacing: -0.035em;
    overflow-wrap: anywhere;
  }
  .location {
    margin-top: 0.25rem;
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }
  .description {
    max-width: 38rem;
    color: var(--color-text);
    line-height: 1.95;
    white-space: pre-line;
    overflow-wrap: anywhere;
  }
  .socials {
    display: flex;
    gap: 1.5rem;
    margin-top: 0.75rem;
    font-size: 0.875rem;
  }
  .socials a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  @media (max-width: 479px) {
    .profile {
      padding-block: 2rem 3rem;
    }
    .identity {
      gap: 1rem;
    }
    .photo {
      width: 64px;
      height: 64px;
      border-radius: 14px;
    }
    .name {
      font-size: 1.625rem;
    }
  }
</style>
