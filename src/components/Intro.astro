---
import { ArrowRight, Code, MapPin } from 'lucide-astro';
import { getProfile, optimizeImageUrl } from '../lib/microcms';

const profile = await getProfile();
const imageUrl = profile.image?.url ? optimizeImageUrl(profile.image.url, 800, 800, 'webp') : null;
---

<section class="section">
  {
    imageUrl && (
      <div class="imageGroup">
        <div class="imageFrame">
          <img
            src={imageUrl}
            alt={profile.name}
            width="800"
            height="800"
            class="profileImage"
            loading="eager"
            decoding="async"
          />
          <div class="imageOverlay"></div>
        </div>
      </div>
    )
  }

  <div class="content">
    <div class="labelRow">
      <div class="labelDot"></div>
      <span class="label">PROFILE</span>
    </div>

    <h2 class="name">{profile.name}</h2>

    <div class="descriptionWrap">
      <p class="description">{profile.description}</p>
    </div>

    <div class="locationWrap">
      <div class="locationRow">
        <div class="locationIconWrap">
          <MapPin size={14} class="locationIcon" />
        </div>
        <span class="locationText">{profile.area}</span>
      </div>
    </div>

    <div class="socialGrid">
      <a href={profile.xUrl} target="_blank" rel="noopener noreferrer" class="card">
        <div class="cardInner">
          <div class="cardIcon">
            <span class="cardX">X</span>
          </div>
          <span class="cardLabel mono-font">X</span>
        </div>
        <ArrowRight size={14} class="cardArrow" />
      </a>

      <a href={profile.githubUrl} target="_blank" rel="noopener noreferrer" class="card">
        <div class="cardInner">
          <div class="cardIcon">
            <Code size={18} />
          </div>
          <span class="cardLabel mono-font">GitHub</span>
        </div>
        <ArrowRight size={14} class="cardArrow" />
      </a>
    </div>
  </div>
</section>

<style>
  .section {
    padding-top: 5rem;
    padding-bottom: 8rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .section {
      grid-template-columns: 1fr 1fr;
      gap: 6rem;
    }
  }

  .imageGroup {
    position: relative;
  }

  .imageFrame {
    position: relative;
    aspect-ratio: 1;
    border-radius: 2rem;
    overflow: hidden;
    background: var(--color-border);
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    transition: box-shadow 0.7s;
  }

  .imageGroup:hover .imageFrame {
    box-shadow: 0 25px 50px -12px rgba(37, 99, 235, 0.1);
  }

  .profileImage {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1s;
    transform: scale(1.05);
  }

  .imageGroup:hover .profileImage {
    transform: scale(1);
  }

  .imageOverlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.2), transparent, transparent);
    opacity: 0.4;
  }

  .content {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .labelRow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .labelDot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    background: var(--color-accent);
  }

  .label {
    font-size: 11px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.4em;
    color: var(--color-text-muted);
  }

  .name {
    font-size: 3rem;
    font-weight: 900;
    letter-spacing: -0.05em;
    color: var(--color-text-strong);
    margin-bottom: 1.5rem;
    line-height: 1;
  }

  @media (min-width: 768px) {
    .name {
      font-size: 4.5rem;
    }
  }

  .descriptionWrap {
    margin-bottom: 1.5rem;
  }

  .description {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.625;
    font-weight: 500;
    max-width: 32rem;
  }

  .locationWrap {
    margin-bottom: 1.5rem;
  }

  .locationRow {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .locationIconWrap {
    width: 2rem;
    height: 2rem;
    border-radius: 9999px;
    background: var(--color-accent-soft);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .locationIcon {
    color: var(--color-accent);
  }

  .locationText {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-text-strong);
    letter-spacing: -0.025em;
    font-style: italic;
  }

  .socialGrid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 640px) {
    .socialGrid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem;
    border-radius: 1rem;
    border: 1px solid var(--color-border);
    background: var(--color-background);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
    transition: border-color 0.3s;
  }

  .card:hover {
    border-color: rgba(24, 24, 27, 0.3);
  }

  .cardInner {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .cardIcon {
    width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 0.75rem;
    background: var(--color-surface);
    transition: background 0.3s, color 0.3s;
  }

  .card:hover .cardIcon {
    background: var(--color-text-strong);
    color: white;
  }

  .cardLabel {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-text-strong);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .cardX {
    font-weight: 900;
    font-size: 1.125rem;
  }

  .cardArrow {
    color: var(--color-text-placeholder);
    transition: color 0.3s, transform 0.3s;
  }

  .card:hover .cardArrow {
    color: var(--color-text-strong);
    transform: translateX(0.25rem);
  }
</style>
