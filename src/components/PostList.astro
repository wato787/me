---
import { getBlogs } from '../lib/microcms';
import { formatDateYmd } from '../lib/date';
const blogs = await getBlogs();
---

<section id="blog" class="section" aria-labelledby="posts-heading">
  <h2 id="posts-heading" class="sectionHeading">記事</h2>
  <div class="list">
    {blogs.map((blog) => (
      <a href={`/blog/${blog.id}`} class="item">
        <time datetime={blog.createdAt} class="date">{formatDateYmd(blog.createdAt).replaceAll('-', '.')}</time>
        <span class="title">{blog.title}</span>
      </a>
    ))}
  </div>
</section>

<style>
  .section {
    margin-bottom: var(--section-gap);
  }
  .list {
    display: flex;
    flex-direction: column;
  }
  .item {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr);
    align-items: baseline;
    gap: 1.5rem;
    padding: 0.8rem 0.625rem;
    margin-inline: -0.625rem;
    border-radius: 5px;
    min-height: 44px;
  }
  .item:hover, .item:focus-visible {
    background: var(--color-surface);
  }
  .date {
    color: var(--color-text-muted);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }
  .title {
    font-size: 1rem;
    line-height: 1.7;
    overflow-wrap: anywhere;
  }
  @media (max-width: 479px) {
    .item {
      grid-template-columns: 1fr;
      gap: 0.15rem;
      padding-block: 0.9rem;
    }
  }
</style>
